# ===========================
# Backend
# ===========================
BACKEND_PORT=8000
# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Orígenes permitidos por CORS (array JSON)
CORS_ORIGINS=["http://localhost:5173"]

# ===========================
# Frontend
# ===========================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# ===========================
# Ollama (Fase 2)
# ===========================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0
# Tiempo máximo total por generación, en segundos
OLLAMA_TIMEOUT=120

# ===========================
# Embeddings (Fase 4)
# ===========================
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ===========================
# PostgreSQL + pgvector (Fase 4)
# ===========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
# Opcional: tiene prioridad sobre POSTGRES_* cuando se define.
# DATABASE_URL=postgresql+psycopg://raguser:ragpassword@localhost:5432/ragdb
VECTOR_TABLE=document_chunks
DOCUMENT_TABLE=uploaded_documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=6000
# Evaluación y borrador en una sola llamada; false restaura el modo de dos llamadas.
RAG_MIN_RELEVANCE_SCORE=0.65
# Fase 8: clasificación independiente antes de generar.
RAG_SINGLE_PASS=false
RAG_MAX_OUTPUT_TOKENS=512
RAG_KEEP_ALIVE=15m
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=2000000
MAX_DOCUMENT_CHUNKS=3000
POSTGRES_CONNECT_TIMEOUT=5
# Milisegundos por sentencia SQL
POSTGRES_STATEMENT_TIMEOUT=30000

# ===========================
# Autenticación (Fase 10)
# ===========================
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=rag-agent
# KEYCLOAK_CLIENT_ID=rag-frontend


